RETROMOL_DUCKDB_HOST_PATH=/data/retromol.duckdb

# Redis PASSWORD (used by redis container command)
REDIS_PASSWORD=supersecretpassword

# Paths to models used by the backend
PARAS_MODEL_PATH=/app/models/all_substrates_model.paras.gz
PARAS_MODEL_HOST_PATH=/srv/models/all_substrates_model.paras.gz

# Cache dir for whichever NRPS model pmp.yml's predictors.nrps.a_domain currently
# selects (see src/retromol/data/pmp.yml) -- a download cache for "paras", or a
# trained-model cache for "paras_cli" (src/retromol_paras/). Populate
# PARAS_CACHE_HOST_PATH by running `python scripts/train_paras.py --cache-dir
# <that path>` once (needs environment.yml's hmmer2/hmmer/muscle tools -- see that
# script's own docstring), so containers mount an already-trained model instead of
# each one training its own on first request.
PARAS_CACHE_DIR=/app/models/paras_cache
PARAS_CACHE_HOST_PATH=/srv/models/paras_cache

PFAM_HMM_DIR_PATH=/app/hmms/
PFAM_HMM_DIR_HOST_PATH=/srv/hmms/

# RQ worker pool sizing -- feeds docker-compose.yml's `deploy.replicas` for the
# `worker` service directly (Compose reads this file for its own ${VAR}
# interpolation; env_file: entries like gui/docker/backend.env are injected into
# containers only, Compose itself never sees them). All replicas drain the single
# heavy_compute queue (see routes/queue.py).
RQ_WORKER_REPLICAS=2