RETROMOL_DUCKDB_HOST_PATH=/data/retromol.duckdb

# Redis PASSWORD (used by redis container command)
REDIS_PASSWORD=supersecretpassword

# Paths to models used by the backend
PARAS_MODEL_PATH=/app/models/all_substrates_model.paras.gz
PARAS_MODEL_HOST_PATH=/srv/models/all_substrates_model.paras.gz

PFAM_HMM_DIR_PATH=/app/hmms/
PFAM_HMM_DIR_HOST_PATH=/srv/hmms/

# RQ worker pool sizing -- these feed docker-compose.yml's `deploy.replicas` for the
# `worker`/`worker_light` services directly (Compose reads this file for its own
# ${VAR} interpolation; env_file: entries like gui/docker/backend.env are injected
# into containers only, Compose itself never sees them). `worker` listens to both
# heavy_compute_pmi and heavy_compute (PMI-first, see routes/queue.py); `worker_light`
# listens only to heavy_compute, so it's never blocked behind a slow PMI job. Set
# RQ_LIGHT_WORKER_REPLICAS=0 to collapse back to a single shared pile.
RQ_WORKER_REPLICAS=1
RQ_LIGHT_WORKER_REPLICAS=1